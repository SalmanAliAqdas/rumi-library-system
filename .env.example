DJANGO_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000
# Final labels require a stable public HTTPS origin (no path/query/credentials).
# Optional international number, country code first; leave blank to hide enquiries.
WHATSAPP_NUMBER=
# Enable HSTS only after the final HTTPS domain and redirects are verified.
HSTS_SECONDS=0
